# ─── MUSE configuration ───────────────────────────────────────────────────────
# Copy to `.env` and fill in. Everything except ANTHROPIC_API_KEY is optional —
# MUSE degrades gracefully, disabling only the connectors whose keys are absent.

# ── Narrative synthesis (REQUIRED for the "why" layer) ────────────────────────
# https://console.anthropic.com/settings/keys
MUSE_ANTHROPIC_API_KEY=
MUSE_NARRATIVE_MODEL=claude-sonnet-5

# ── Social connectors (all optional; each one that's blank is skipped) ────────

# ── Reddit ────────────────────────────────────────────────────────────────────
# https://www.reddit.com/prefs/apps → "are you a developer? create an app…"
#   type:         script
#   redirect uri: http://localhost:8080   (unused, but the form demands one)
# CLIENT_ID is the string under the app name; CLIENT_SECRET is labelled "secret".
# Free tier is 100 queries/minute per OAuth client averaged over 10 minutes.
# MUSE polls once per MUSE_INGEST_INTERVAL_SECONDS, so it sits far inside that.
# Commercial use requires a separate agreement with Reddit — the free tier is
# for non-commercial use only.
MUSE_REDDIT_CLIENT_ID=
MUSE_REDDIT_CLIENT_SECRET=
# Reddit rejects generic user agents. Put your actual username in.
MUSE_REDDIT_USER_AGENT=muse-trend-analysis/0.1 by u/yourusername

# ── YouTube Data API v3 ───────────────────────────────────────────────────────
# console.cloud.google.com → create/select a project
#   1. APIs & Services → Library → "YouTube Data API v3" → Enable
#   2. APIs & Services → Credentials → Create credentials → API key
#   3. Restrict the key to the YouTube Data API v3 (Credentials → the key →
#      API restrictions). An unrestricted key is a standing liability.
# Free quota is 10,000 units/day; a search costs 100 units, so ~100 searches.
MUSE_YOUTUBE_API_KEY=

# ── Bluesky ───────────────────────────────────────────────────────────────────
# REQUIRED for this connector as of 2026 — public.api.bsky.app now returns 403
# for unauthenticated app.bsky.feed.searchPosts. Without both values below the
# connector reports itself disabled instead of silently returning nothing.
#   Bluesky → Settings → Privacy and security → App passwords → Add App Password
# Use an app password, never your account password: it is revocable on its own
# and cannot change account settings or delete the account.
MUSE_BLUESKY_IDENTIFIER=you.bsky.social
MUSE_BLUESKY_APP_PASSWORD=

# Google Trends needs no key (unofficial endpoint, best-effort).
MUSE_GOOGLE_TRENDS_ENABLED=true

# ── Chart sources ─────────────────────────────────────────────────────────────
# These report ordinal chart positions rather than engagement counts, so a track
# parked at #1 for weeks reads as velocity ~0 (popular, not *trending*) while a
# track climbing #38 → #6 produces a large one. That is the intended behaviour.

# Deezer — no key, no account, nothing to rotate. Global chart plus six genre
# charts, 50 tracks each.
MUSE_DEEZER_ENABLED=true

# Apple Music — public marketing RSS feeds, also keyless. Comma-separated ISO
# country codes; each one costs two extra HTTP calls per poll.
MUSE_APPLE_MUSIC_ENABLED=true
MUSE_APPLE_MUSIC_COUNTRIES=us,gb

# ── Last.fm ───────────────────────────────────────────────────────────────────
# https://www.last.fm/api/account/create — instant, free, no review step.
# Use the "API key" it shows you; the shared secret is only needed for the
# authenticated write methods, which MUSE does not call.
# Unlike the charts above, Last.fm returns real listener counts. Those are
# cumulative totals, so a Last.fm velocity is a growth rate that approaches zero
# rather than a spike that decays — read it as "how fast is this gaining new
# listeners", not as a rise-and-fall curve.
MUSE_LASTFM_API_KEY=
# Last.fm's geo charts key on full country NAMES, not ISO codes.
MUSE_LASTFM_COUNTRIES=united states,united kingdom

# ── Correlation evidence bar ──────────────────────────────────────────────────
# How much overlap a social signal needs before MUSE calls it a driver. Lower
# these and the engine starts reporting coincidences as causes.
MUSE_CORRELATION_MIN_DISTINCT_TERMS=2
MUSE_CORRELATION_MAX_DF_RATIO=0.15
MUSE_CORRELATION_MIN_RELEVANCE=0.05

# ── Audio analysis ────────────────────────────────────────────────────────────
# "stats" = fast deterministic spectral embedder, no model download (default)
# "clap"  = laion/clap-htsat-unfused, higher quality, ~600MB first-run download
MUSE_EMBEDDING_BACKEND=stats
MUSE_MEDIA_ROOT=/data/media

# ── Fatigue Index tuning ──────────────────────────────────────────────────────
MUSE_FATIGUE_NEIGHBOR_RADIUS=0.82
MUSE_FATIGUE_HALF_LIFE_DAYS=90
MUSE_FATIGUE_MIN_NEIGHBORS=12

# ── Ingestion cadence ─────────────────────────────────────────────────────────
MUSE_INGEST_INTERVAL_SECONDS=900
